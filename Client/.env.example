# ── Clerk (client-side) ────────────────────────────────────────────────────
# Found in Clerk Dashboard → API Keys → Publishable keys
# This key is safe to expose in the browser bundle.
VITE_CLERK_PUBLISHABLE_KEY=

# ── Backend API URL ────────────────────────────────────────────────────────
# The full URL of your deployed backend (no trailing slash)
# e.g. https://klar-api.onrender.com
# Leave blank for local dev (falls back to http://localhost:5000)
VITE_API_URL=
