# ── MongoDB Atlas ──────────────────────────────────────────────────────────
# Paste the full connection string from Atlas → Connect → Drivers
MONGODB_URI=

# ── Adzuna Job API ─────────────────────────────────────────────────────────
# Get these from https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── Google for Jobs via JSearch (RapidAPI) ─────────────────────────────────
# Get this from https://rapidapi.com/ → JSearch → subscribe → X-RapidAPI-Key
JSEARCH_API_KEY=

# ── Clerk (server-side) ────────────────────────────────────────────────────
# Found in Clerk Dashboard → API Keys → Secret keys
# NEVER share or commit this value
CLERK_SECRET_KEY=

# ── CORS ───────────────────────────────────────────────────────────────────
# The exact URL of your deployed frontend (no trailing slash)
# e.g. https://klar.onrender.com
CLIENT_ORIGIN=

# ── Ingest endpoint protection ─────────────────────────────────────────────
# Any random string you invent. Pass it as the X-Ingest-Secret header when
# manually hitting POST /api/ingest/adzuna. The in-process cron never needs it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_SECRET=

# ── Server port ────────────────────────────────────────────────────────────
# Render sets PORT automatically; leave blank unless running locally on a
# non-default port.
PORT=
